---
const { cardContent } = Astro.props;
---

<!-- html{

--content-width: 
--card-padding: 
--card-gap
--card-border-radius 
--card-background 
--card-text-color 
} -->
<ul class="full">
  {
    cardContent.map((card) => (
      <li>
        <h3>{card.title}</h3>
        <p>{card.body}</p>
      </li>
    ))
  }
</ul>

<style>
  ul {
    list-style: none;
    display: flex;
    gap: 1rem;
    overflow-x: auto; /* Scroll på x-aksen */
    scroll-snap-type: x mandatory; /* Aktiver snap på x-aksen */
    scroll-behavior: smooth;
  }
  li {
    padding: 2rem;
    background-color: rgb(165, 168, 171);
    border-radius: 10px;
    flex: 0 0 40%; /* Hvert item tager 80% af bredden */
    scroll-snap-align: start; /* Snap ved start af elementet */
    scroll-snap-stop: always;
  }
  .full {
    grid-column: full;
  }
</style>
